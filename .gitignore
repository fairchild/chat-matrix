# process state and logs from scripts/run.sh
.run/

# python
.venv/
__pycache__/
*.pyc

# node
node_modules/
.next/
*.tsbuildinfo
# Next writes next-env.d.ts itself and says so in the file. Its two import
# lines point at .next/types under `build` and .next/dev/types under `dev`, so a
# tracked copy flips with whichever ran last and `run.sh` dirties a fresh clone.
# The shadcn and folio cells already ignore it; this covers the other three.
next-env.d.ts

# hosted builds: static exports, OpenNext output, wrangler state, generated types
out/
.open-next/
.wrangler/
worker-configuration.d.ts
index/dist/

# generated from the stack READMEs' Ergonomics notes; the README is the source
index/notes/

# local config and data. `.env.local` and `.dev.vars` are the paths setup.sh and
# every README actually use; the rest are here because a public repo takes
# contributions from people who have other habits, and a key is not the kind of
# mistake you want to catch in review.
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key
*.p12
*.pfx
.env.local
data/
*.db

# screenshots, recordings and reports from scripts/probe.sh
probes/artifacts/

# maildir-shared backend — in-flight dir lives in git-common-dir
backlog/doing

# a contributor's local Claude permissions, which are theirs and not the repo's
.claude/settings.local.json
